# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ── Phase 2 API ─────────────────────────────────────────────────────────────
# Required in production. Generate with: openssl rand -hex 32  (NEVER ship the default)
JWT_SECRET="CHANGE_ME_use_openssl_rand_hex_32"
JWT_EXPIRES_IN="3600"
JWT_REFRESH_EXPIRES_IN="604800"
MAX_UPLOAD_BYTES="5242880"

# ── Phase 3 Database ────────────────────────────────────────────────────────
# PostgreSQL connection string. Leave unset for in-memory development mode.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/konstrivo"
# Separate PostgreSQL connection string for test-only integration runs.
# Must be different from DATABASE_URL and must not point to production.
TEST_DATABASE_URL=

# ── Phase 1.1 Admin Bootstrap ────────────────────────────────────────────────
# Set these to create the first admin user on startup.
# Leave unset to skip admin bootstrap (no admin user created).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Email settings (optional) ─────────────────────────────────────────────
# SendGrid API key (or leave empty to disable email sending)
SENDGRID_API_KEY=
# From address for outgoing emails (e.g. noreply@yourdomain.com)
EMAIL_FROM=
# Public frontend URL used to build reset links.
# REQUIRED in production: must be an absolute http(s) URL, NOT localhost.
# If missing/invalid in production the server silently skips reset emails
# (never sends a localhost link). Localhost is acceptable for local dev/tests.
PUBLIC_APP_URL=http://localhost:5173

